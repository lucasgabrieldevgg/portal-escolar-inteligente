// Portal Escolar Inteligente - schema v0.6 (Postgres + Supabase)
// Roles: ALUNO | PROFESSOR | BIBLIOTECARIO | COORDENACAO | ADMIN

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  senhaHash     String
  name          String
  role          String   @default("ALUNO")
  turno         String?
  turmaId       String?
  turma         Turma?   @relation(fields: [turmaId], references: [id])
  materias      String?
  avatarConfig  String?
  xp            Int      @default(0)
  xpTotal       Int      @default(0)
  moedinhas     Int      @default(50)
  iaUsadasHoje  Int      @default(0)
  iaDataUltima  String?
  iaLimiteDiario Int     @default(15)
  sequenciaDias Int      @default(0)
  ativo         Boolean  @default(true)
  criadoPorId   String?
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  avisosPublicados Aviso[]
  avisosTurmaPublicados AvisoTurma[]
  tarefasCriadas   Tarefa[]
  entregasFeitas   Entrega[]    @relation("EntregaAluno")
  entregasCorrigidas Entrega[]  @relation("EntregaCorretor")
  xpLogs           XPLog[]
  bugsReportados   BugReport[]
  inscricoesDev    InscricaoDev[]
  userBadges       UserBadge[]
  userSkins        UserSkin[]
  resumosBiblioteca ResumoBiblioteca[] @relation("ResumosAluno")
  resumosValidados ResumoBiblioteca[]  @relation("ResumosValidador")
  sessaoAtual      Sessao?
}

model Turma {
  id        String @id @default(cuid())
  nome      String @unique
  turno     String
  ano       String
  alunos    User[]
  tarefas   Tarefa[]
  avisosTurma AvisoTurma[]
  createdAt DateTime @default(now())
}

model Aviso {
  id        String @id @default(cuid())
  titulo    String
  conteudo  String
  categoria String @default("GERAL")
  destaque  Boolean @default(false)
  autorId   String
  autor     User   @relation(fields: [autorId], references: [id])
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model AvisoTurma {
  id        String @id @default(cuid())
  titulo    String
  conteudo  String
  turmaId   String
  turma     Turma  @relation(fields: [turmaId], references: [id])
  professorId String
  professor User   @relation(fields: [professorId], references: [id])
  createdAt DateTime @default(now())
}

model Tarefa {
  id           String @id @default(cuid())
  titulo       String
  descricao    String
  turmaId      String
  turma        Turma  @relation(fields: [turmaId], references: [id])
  professorId  String
  professor    User   @relation(fields: [professorId], references: [id])
  xpRecompensa Int    @default(50)
  moedinhasRecompensa Int @default(10)
  prazo        DateTime?
  createdAt    DateTime @default(now())
  entregas     Entrega[]
}

model Entrega {
  id           String @id @default(cuid())
  tarefaId     String
  tarefa       Tarefa @relation(fields: [tarefaId], references: [id])
  alunoId      String
  aluno        User   @relation("EntregaAluno", fields: [alunoId], references: [id])
  conteudo     String
  status       String @default("PENDENTE")
  xpConcedido  Int?
  moedinhasConcedidas Int?
  corretorId   String?
  corretor     User?  @relation("EntregaCorretor", fields: [corretorId], references: [id])
  feedback     String?
  createdAt    DateTime @default(now())
  corrigidoEm  DateTime?
}

model XPLog {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  quantidade Int
  motivo     String
  origem     String
  tipo       String @default("XP")
  createdAt  DateTime @default(now())
}

model BugReport {
  id           String @id @default(cuid())
  userId       String
  user         User   @relation(fields: [userId], references: [id])
  local        String
  acao         String
  ocorreu      String
  esperado     String
  categoria    String @default("SUGESTAO")
  status       String @default("ABERTO")
  recompensaXP Int?
  createdAt    DateTime @default(now())
  resolvidoEm  DateTime?
}

model Badge {
  id           String @id @default(cuid())
  nome         String @unique
  descricao    String
  icone        String
  raridade     String @default("COMUM")
  tipo         String @default("ACADEMICA")
  daXP         Boolean @default(false)
  xpRecompensa Int    @default(0)
  apenasAdmin  Boolean @default(false)
  automatica   Boolean @default(false)
  userBadges   UserBadge[]
}

model UserBadge {
  id         String @id @default(cuid())
  userId     String
  user       User   @relation(fields: [userId], references: [id])
  badgeId    String
  badge      Badge  @relation(fields: [badgeId], references: [id])
  concedidoEm DateTime @default(now())
  concedidoPor String?

  @@unique([userId, badgeId])
}

model Skin {
  id          String @id @default(cuid())
  nome        String @unique
  descricao   String
  tipo        String
  raridade    String @default("COMUM")
  preco       Int    @default(10)
  config      String
  icone       String
  ativa       Boolean @default(true)
  userSkins   UserSkin[]
}

model UserSkin {
  id        String @id @default(cuid())
  userId    String
  user      User   @relation(fields: [userId], references: [id])
  skinId    String
  skin      Skin   @relation(fields: [skinId], references: [id])
  compradoEm DateTime @default(now())

  @@unique([userId, skinId])
}

model InscricaoDev {
  id          String @id @default(cuid())
  userId      String
  user        User   @relation(fields: [userId], references: [id])
  area        String
  experiencia String?
  motivo      String
  analiseIA   String?
  scoreIA     Int?
  status      String @default("PENDENTE")
  createdAt   DateTime @default(now())
  decididoEm  DateTime?
}

model Sessao {
  id        String @id @default(cuid())
  token     String @unique
  userId    String @unique
  user      User   @relation(fields: [userId], references: [id])
  createdAt DateTime @default(now())
  expiresAt DateTime
}

model ResumoBiblioteca {
  id          String @id @default(cuid())
  alunoId     String
  aluno       User   @relation("ResumosAluno", fields: [alunoId], references: [id])
  livroTitulo String
  livroAutor  String?
  resumo      String
  status      String @default("PENDENTE")
  xpRecompensa Int   @default(30)
  moedinhasRecompensa Int @default(15)
  validadoPorId String?
  validadoPor  User?  @relation("ResumosValidador", fields: [validadoPorId], references: [id])
  feedback    String?
  createdAt   DateTime @default(now())
  validadoEm  DateTime?
}

model Setting {
  id        String @id @default(cuid())
  chave     String @unique
  valor     String
  updatedAt DateTime @updatedAt
}
